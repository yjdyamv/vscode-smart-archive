{
  "name": "smart-archive",
  "displayName": "Smart Archive",
  "description": "Compress and decompress files using JS7z + libarchive.js. Supports 7z, ZIP, RAR, TAR, GZip, BZip2, XZ with AES-256 encryption.",
  "version": "1.5.0",
  "publisher": "yjdyamv",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yjdyamv/vscode-smart-archive"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:yjdyamv.smart-archive.compress",
    "onCommand:yjdyamv.smart-archive.decompress",
    "onCommand:yjdyamv.smart-archive.browse",
    "onCommand:yjdyamv.smart-archive.paste",
    "onCommand:yjdyamv.smart-archive.addToArchive",
    "onCustomEditor:archiveViewer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "archiveViewer",
        "displayName": "Archive Viewer",
        "selector": [
          {
            "filenamePattern": "*.7z"
          },
          {
            "filenamePattern": "*.zip"
          },
          {
            "filenamePattern": "*.rar"
          },
          {
            "filenamePattern": "*.tar"
          },
          {
            "filenamePattern": "*.gz"
          },
          {
            "filenamePattern": "*.bz2"
          },
          {
            "filenamePattern": "*.xz"
          },
          {
            "filenamePattern": "*.tar.gz"
          },
          {
            "filenamePattern": "*.tar.bz2"
          },
          {
            "filenamePattern": "*.tar.xz"
          },
          {
            "filenamePattern": "*.tar.zst"
          },
          {
            "filenamePattern": "*.tar.lz"
          },
          {
            "filenamePattern": "*.tar.lzma"
          },
          {
            "filenamePattern": "*.tgz"
          },
          {
            "filenamePattern": "*.tbz2"
          },
          {
            "filenamePattern": "*.tbz"
          },
          {
            "filenamePattern": "*.txz"
          },
          {
            "filenamePattern": "*.tzst"
          },
          {
            "filenamePattern": "*.tlz"
          },
          {
            "filenamePattern": "*.wim"
          },
          {
            "filenamePattern": "*.zst"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "yjdyamv.smart-archive.compress",
        "title": "Smart Archive: Compress"
      },
      {
        "command": "yjdyamv.smart-archive.decompress",
        "title": "Smart Archive: Decompress"
      },
      {
        "command": "yjdyamv.smart-archive.browse",
        "title": "Smart Archive: Browse Contents"
      },
      {
        "command": "yjdyamv.smart-archive.paste",
        "title": "Smart Archive: Paste Copied Files"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "yjdyamv.smart-archive.paste",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "yjdyamv.smart-archive.compress",
          "group": "7_modification"
        },
        {
          "command": "yjdyamv.smart-archive.decompress",
          "group": "7_modification"
        },
        {
          "command": "yjdyamv.smart-archive.browse",
          "group": "7_modification"
        }
      ]
    },
    "configuration": {
      "title": "Smart Archive",
      "properties": {
        "smart-archive.defaultFormat": {
          "type": "string",
          "default": "7z",
          "enum": [
            "7z",
            "zip",
            "tar",
            "tar.gz",
            "tar.bz2",
            "tar.xz",
            "tar.zst",
            "gz",
            "bz2",
            "xz",
            "wim"
          ],
          "enumDescriptions": [
            "7-Zip — best compression ratio, AES-256 encryption",
            "ZIP — universal compatibility, AES-256 encryption",
            "TAR — archive only, no compression",
            "TAR + GZip — compressed archive with directory structure",
            "TAR + BZip2 — high compression with directory structure",
            "TAR + XZ — best compression with directory structure",
            "TAR + Zstandard — fast compression with directory structure",
            "GZip — single-file compression (auto-wraps in TAR for folders)",
            "BZip2 — high compression for single files",
            "XZ — high compression for single files",
            "WIM — Windows Imaging Format"
          ],
          "description": "Default archive format used when compressing files."
        },
        "smart-archive.defaultCompressionLevel": {
          "type": "integer",
          "default": 5,
          "minimum": 0,
          "maximum": 9,
          "enum": [
            0,
            1,
            3,
            5,
            7,
            9
          ],
          "enumDescriptions": [
            "0 – Store (no compression, fastest)",
            "1 – Fastest",
            "3 – Fast",
            "5 – Normal",
            "7 – Maximum",
            "9 – Ultra (slowest, best ratio)"
          ],
          "description": "Default compression level (0=store, 5=normal, 9=ultra)."
        },
        "smart-archive.defaultOutputDir": {
          "type": "string",
          "default": "source",
          "enum": [
            "source",
            "prompt"
          ],
          "enumDescriptions": [
            "Extract/compress next to the source file",
            "Always prompt for output directory"
          ],
          "description": "Where to place extracted/compressed files by default."
        },
        "smart-archive.maxFileSizeMiB": {
          "type": "integer",
          "default": 1024,
          "minimum": 1,
          "maximum": 102400,
          "description": "Maximum allowed size for a single decompressed file (MiB). Default: 1024 MiB (= 1 GiB)."
        },
        "smart-archive.maxTotalSizeMiB": {
          "type": "integer",
          "default": 10240,
          "minimum": 1,
          "maximum": 512000,
          "description": "Maximum total decompressed size across all files (MiB). Default: 10240 MiB (= 10 GiB)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "build:webview": "cd webview-ui && npm run build",
    "dev:webview": "cd webview-ui && npm run dev",
    "install:webview": "cd webview-ui && npm install",
    "precompile": "npm run build:webview",
    "test": "npm run compile && tsc -p test && node test/out/core.test.js && node test/out/preview.test.js",
    "test:extension": "node test/runTest.js",
    "format": "oxfmt --write src/",
    "format:check": "oxfmt --check src/",
    "lint": "oxlint -D correctness -D suspicious -A no-underscore-dangle -A unicorn/require-post-message-target-origin -A unicorn/no-array-sort src/",
    "lint:fix": "oxlint -D correctness -D suspicious -A no-underscore-dangle -A unicorn/require-post-message-target-origin -A unicorn/no-array-sort --fix src/",
    "typecheck": "tsc -p . --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "package": "npm run compile && vsce package",
    "package:ovsx": "npm run compile && npx ovsx package",
    "publish": "npx vsce publish",
    "publish:ovsx": "npm run compile && npx ovsx publish",
    "vscode:prepublish": "npm run build:webview && npm run compile"
  },
  "overrides": {
    "encoding-sniffer": "1.0.2"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "^0.0.27",
    "iconv-lite": "^0.7.2",
    "js7z-tools": "^2.5.0",
    "libarchive-wasm": "^1.2.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.9.1",
    "glob": "^10.0.0",
    "mocha": "^11.7.5",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3"
  }
}
