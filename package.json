        "smart-archiver.compression.method": {
          "type": "string",
          "default": "flzma2",
          "enum": [
            "flzma2",
            "lzma2",
            "zstd",
            "brotli",
            "lz4",
            "deflate",
            "bzip2",
            "lizard"
          ],
          "enumDescriptions": [
            "%config.compression.method.flzma2%",
            "%config.compression.method.lzma2%",
            "%config.compression.method.zstd%",
            "%config.compression.method.brotli%",
            "%config.compression.method.lz4%",
            "%config.compression.method.deflate%",
            "%config.compression.method.bzip2%",
            "%config.compression.method.lizard%"
          ],
          "description": "%config.compression.method.description%"
        },
        "smart-archiver.compression.solid": {
          "type": "boolean",
          "default": false,
          "description": "%config.compression.solid.description%"
        },
        "smart-archiver.worker.memoryMb": {
          "type": "integer",
          "default": 8192,
          "minimum": 0,
          "description": "%config.worker.memoryMb.description%"
        },
        "smart-archiver.worker.poolSize": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 2,
          "description": "%config.worker.poolSize.description%"
        },
        "smart-archiver.log.level": {
          "type": "string",
          "default": "info",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "enumDescriptions": [
            "%config.log.level.error%",
            "%config.log.level.warn%",
            "%config.log.level.info%",
            "%config.log.level.debug%"
          ],
          "description": "%config.log.level.description%"
        },
        "smart-archiver.log.historyBytes": {
          "type": "integer",
          "default": 1048576,
          "minimum": 65536,
          "maximum": 16777216,
          "description": "%config.log.historyBytes.description%"
        },
        "smart-archiver.cache.maxPreviewMB": {
          "type": "integer",
          "default": 10,
          "minimum": 0,
          "description": "%config.cache.maxPreviewMB.description%"
        },
        "smart-archiver.cache.ttlDays": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "maximum": 365,
          "description": "%config.cache.ttlDays.description%"
        },
        "smart-archiver.cache.maxMB": {
          "type": "integer",
          "default": 1024,
          "minimum": 1,
          "description": "%config.cache.maxMB.description%"
        },
        "smart-archiver.cache.maxFiles": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "description": "%config.cache.maxFiles.description%"
        }
      }
    }
  },
  "icon": "icon_128x128.png",
  "engines": {
    "vscode": "^1.85.0"
  },
