{
  "name": "smart-archive",
  "displayName": "Smart Archive",
  "description": "Compress and decompress files using JS7z + zstd-wasm. Supports 7z, ZIP, RAR, TAR, GZip, BZip2, XZ, Zstd, WIM with AES-256 encryption.",
  "version": "1.15.3",
  "publisher": "yjdyamv",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yjdyamv/vscode-smart-archive"
  },
  "icon": "icon_128x128.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "archive",
    "compress",
    "decompress",
    "7z",
    "zip",
    "rar",
    "tar",
    "gz",
    "bzip2",
    "xz",
    "zstd",
    "encrypt",
    "AES-256",
    "multi-volume"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "archiveViewer",
        "displayName": "Archive Viewer",
        "selector": [
          {
            "filenamePattern": "*.7z"
          },
          {
            "filenamePattern": "*.7z.*"
          },
          {
            "filenamePattern": "*.zip"
          },
          {
            "filenamePattern": "*.zip.*"
          },
          {
            "filenamePattern": "*.rar"
          },
          {
            "filenamePattern": "*.r[0-9][0-9]"
          },
          {
            "filenamePattern": "*.tar"
          },
          {
            "filenamePattern": "*.gz"
          },
          {
            "filenamePattern": "*.bz2"
          },
          {
            "filenamePattern": "*.xz"
          },
          {
            "filenamePattern": "*.tar.gz"
          },
          {
            "filenamePattern": "*.tar.bz2"
          },
          {
            "filenamePattern": "*.tar.xz"
          },
          {
            "filenamePattern": "*.tar.zst"
          },
          {
            "filenamePattern": "*.tar.lz"
          },
          {
            "filenamePattern": "*.tar.lzma"
          },
          {
            "filenamePattern": "*.tar.lz4"
          },
          {
            "filenamePattern": "*.tgz"
          },
          {
            "filenamePattern": "*.tbz2"
          },
          {
            "filenamePattern": "*.tbz"
          },
          {
            "filenamePattern": "*.txz"
          },
          {
            "filenamePattern": "*.tzst"
          },
          {
            "filenamePattern": "*.tlz"
          },
          {
            "filenamePattern": "*.tlz4"
          },
          {
            "filenamePattern": "*.tar.br"
          },
          {
            "filenamePattern": "*.tbr"
          },
          {
            "filenamePattern": "*.wim"
          },
          {
            "filenamePattern": "*.zst"
          },
          {
            "filenamePattern": "*.cab"
          },
          {
            "filenamePattern": "*.arj"
          },
          {
            "filenamePattern": "*.lzh"
          },
          {
            "filenamePattern": "*.chm"
          },
          {
            "filenamePattern": "*.msi"
          },
          {
            "filenamePattern": "*.z"
          },
          {
            "filenamePattern": "*.cpio"
          },
          {
            "filenamePattern": "*.rpm"
          },
          {
            "filenamePattern": "*.deb"
          },
          {
            "filenamePattern": "*.uha"
          },
          {
            "filenamePattern": "*.xar"
          },
          {
            "filenamePattern": "*.iso"
          },
          {
            "filenamePattern": "*.vhd"
          },
          {
            "filenamePattern": "*.vmdk"
          },
          {
            "filenamePattern": "*.fat"
          },
          {
            "filenamePattern": "*.ntfs"
          },
          {
            "filenamePattern": "*.squashfs"
          },
          {
            "filenamePattern": "*.dmg"
          },
          {
            "filenamePattern": "*.hfs"
          },
          {
            "filenamePattern": "*.apm"
          },
          {
            "filenamePattern": "*.mbr"
          },
          {
            "filenamePattern": "*.elf"
          },
          {
            "filenamePattern": "*.macho"
          },
          {
            "filenamePattern": "*.swf"
          },
          {
            "filenamePattern": "*.flv"
          },
          {
            "filenamePattern": "*.vsix"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "yjdyamv.smart-archive.compress",
        "title": "Smart Archive: Compress",
        "shortTitle": "Compress",
        "icon": "$(archive)"
      },
      {
        "command": "yjdyamv.smart-archive.decompress",
        "title": "Smart Archive: Decompress",
        "shortTitle": "Decompress",
        "icon": "$(folder-opened)"
      },
      {
        "command": "yjdyamv.smart-archive.browse",
        "title": "Smart Archive: Browse Contents",
        "shortTitle": "Browse Contents",
        "icon": "$(list-tree)"
      },
      {
        "command": "yjdyamv.smart-archive.paste",
        "title": "Smart Archive: Paste Copied Files",
        "shortTitle": "Paste Files"
      },
      {
        "command": "yjdyamv.smart-archive.addToArchive",
        "title": "Smart Archive: Add to Archive",
        "shortTitle": "Add to Archive"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "yjdyamv.smart-archive.compress",
          "when": "false"
        },
        {
          "command": "yjdyamv.smart-archive.decompress",
          "when": "false"
        },
        {
          "command": "yjdyamv.smart-archive.browse",
          "when": "false"
        },
        {
          "command": "yjdyamv.smart-archive.paste",
          "when": "false"
        },
        {
          "command": "yjdyamv.smart-archive.addToArchive",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "yjdyamv.smart-archive.compress",
          "group": "7_modification"
        },
        {
          "command": "yjdyamv.smart-archive.decompress",
          "group": "7_modification",
          "when": "resourceFilename =~ /\\.(7z|7z\\.[0-9]+|zip|zip\\.[0-9]+|rar|r\\d{2}|tar|gz|bz2|xz|zst|wim|tgz|tbz2|tbz|txz|tzst|tlz|tlz4|tbr|lz|lzma|tar\\.gz|tar\\.bz2|tar\\.xz|tar\\.zst|tar\\.lz|tar\\.lzma|tar\\.lz4|tar\\.br|cab|arj|lzh|chm|msi|z|cpio|rpm|deb|uha|xar|iso|vhd|vmdk|fat|ntfs|squashfs|dmg|hfs|apm|mbr|elf|macho|swf|flv|vsix)$/"
        },
        {
          "command": "yjdyamv.smart-archive.browse",
          "group": "7_modification",
          "when": "resourceFilename =~ /\\.(7z|7z\\.[0-9]+|zip|zip\\.[0-9]+|rar|r\\d{2}|tar|gz|bz2|xz|zst|wim|tgz|tbz2|tbz|txz|tzst|tlz|tlz4|tbr|lz|lzma|tar\\.gz|tar\\.bz2|tar\\.xz|tar\\.zst|tar\\.lz|tar\\.lzma|tar\\.lz4|tar\\.br|cab|arj|lzh|chm|msi|z|cpio|rpm|deb|uha|xar|iso|vhd|vmdk|fat|ntfs|squashfs|dmg|hfs|apm|mbr|elf|macho|swf|flv|vsix)$/"
        }
      ]
    },
    "configuration": {
      "title": "Smart Archive",
      "properties": {
        "smart-archive.defaultFormat": {
          "type": "string",
          "default": "7z",
          "enum": [
            "7z",
            "zip",
            "tar",
            "tar.gz",
            "tar.bz2",
            "tar.xz",
            "tar.zst",
            "tar.lz4",
            "tar.br",
            "wim"
          ],
          "enumDescriptions": [
            "%config.defaultFormat.7z%",
            "%config.defaultFormat.zip%",
            "%config.defaultFormat.tar%",
            "%config.defaultFormat.tar.gz%",
            "%config.defaultFormat.tar.bz2%",
            "%config.defaultFormat.tar.xz%",
            "%config.defaultFormat.tar.zst%",
            "%config.defaultFormat.tar.lz4%",
            "%config.defaultFormat.tar.br%",
            "%config.defaultFormat.wim%"
          ],
          "description": "%config.defaultFormat.description%"
        },
        "smart-archive.defaultCompressionLevel": {
          "type": "integer",
          "default": 5,
          "minimum": 0,
          "maximum": 9,
          "enum": [
            0,
            1,
            3,
            5,
            7,
            9
          ],
          "enumDescriptions": [
            "%config.defaultCompressionLevel.0%",
            "%config.defaultCompressionLevel.1%",
            "%config.defaultCompressionLevel.3%",
            "%config.defaultCompressionLevel.5%",
            "%config.defaultCompressionLevel.7%",
            "%config.defaultCompressionLevel.9%"
          ],
          "description": "%config.defaultCompressionLevel.description%"
        },
        "smart-archive.defaultOutputDir": {
          "type": "string",
          "default": "source",
          "enum": [
            "source",
            "prompt"
          ],
          "enumDescriptions": [
            "%config.defaultOutputDir.source%",
            "%config.defaultOutputDir.prompt%"
          ],
          "description": "%config.defaultOutputDir.description%"
        },
        "smart-archive.maxFileSize": {
          "type": [
            "integer",
            "string"
          ],
          "default": "1g",
          "pattern": "^(\\d+(\\.\\d+)?)\\s*(k|m|g)$",
          "description": "%config.maxFileSize.description%"
        },
        "smart-archive.maxTotalSize": {
          "type": [
            "integer",
            "string"
          ],
          "default": "10g",
          "pattern": "^(\\d+(\\.\\d+)?)\\s*(k|m|g)$",
          "description": "%config.maxTotalSize.description%"
        },
        "smart-archive.collapsedDirPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".npm",
            ".yarn",
            ".venv",
            "venv",
            "__pycache__",
            ".pytest_cache",
            ".mypy_cache",
            ".tox",
            ".eggs",
            "site-packages",
            ".git",
            ".svn",
            ".hg",
            "dist",
            "build",
            "target",
            "out",
            "output",
            ".next",
            ".nuxt",
            ".output",
            ".svelte-kit",
            ".idea",
            ".vscode",
            ".vs",
            "coverage",
            ".nyc_output",
            ".cache",
            ".turbo",
            ".parcel-cache",
            "vendor",
            "bower_components",
            ".terraform"
          ],
          "description": "%config.collapsedDirPatterns.description%"
        },
        "smart-archive.compressExcludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".npm",
            ".yarn",
            ".venv",
            "venv",
            "__pycache__",
            ".pytest_cache",
            ".mypy_cache",
            ".tox",
            ".eggs",
            "site-packages",
            ".git",
            ".svn",
            ".hg",
            "dist",
            "build",
            "target",
            "out",
            "output",
            ".next",
            ".nuxt",
            ".output",
            ".svelte-kit",
            ".idea",
            ".vscode",
            ".vs",
            "coverage",
            ".nyc_output",
            ".cache",
            ".turbo",
            ".parcel-cache",
            "vendor",
            "bower_components",
            ".terraform"
          ],
          "description": "%config.compressExcludePatterns.description%"
        },
        "smart-archive.volumeSizes": {
          "type": "object",
          "default": {
            "1.44M": "1440k",
            "10M": "10m",
            "25M": "25m",
            "50M": "50m",
            "100M": "100m",
            "200M": "200m",
            "650M": "650m",
            "700M": "700m",
            "1G": "1g",
            "2G": "2g",
            "4.7G": "4700m"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^\\d+[kmg]$"
          },
          "markdownDescription": "%config.volumeSizes.description%"
        },
        "smart-archive.useSystem7z": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "%config.useSystem7z.auto%",
            "%config.useSystem7z.always%",
            "%config.useSystem7z.never%"
          ],
          "description": "%config.useSystem7z.description%"
        },
        "smart-archive.useSystemZstd": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "%config.useSystemZstd.auto%",
            "%config.useSystemZstd.always%",
            "%config.useSystemZstd.never%"
          ],
          "description": "%config.useSystemZstd.description%"
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"['out','media/vue','coverage'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\"",
    "postinstall": "npm --prefix webview-ui install",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "build:webview": "npm --prefix webview-ui run build",
    "dev:webview": "npm --prefix webview-ui run dev",
    "build": "npm run build:webview && npm run compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "format": "oxfmt --write src/ test/ webview-ui/src/",
    "format:check": "oxfmt --check src/ test/ webview-ui/src/",
    "lint": "oxlint -D correctness -D suspicious -A no-underscore-dangle -A unicorn/require-post-message-target-origin -A unicorn/no-array-sort src/ test/ webview-ui/src/",
    "lint:fix": "oxlint -D correctness -D suspicious -A no-underscore-dangle -A unicorn/require-post-message-target-origin -A unicorn/no-array-sort --fix src/ test/ webview-ui/src/",
    "typecheck": "tsc -p . --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "release": "npm run build && npm run check && npm run package",
    "package": "vsce package",
    "package:ovsx": "npm run build && npx ovsx package",
    "publish": "npm run build && npx vsce publish",
    "publish:ovsx": "npm run build && npx ovsx publish",
    "vscode:prepublish": "npm run build"
  },
  "overrides": {
    "encoding-sniffer": "1.0.2"
  },
  "dependencies": {
    "@addmaple/lz4": "^0.2.0",
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@vscode/codicons": "^0.0.45",
    "brotli-wasm": "^3.0.1",
    "iconv-lite": "^0.7.3",
    "js7z-tools": "^2.5.0",
    "lz4js": "^0.2.0",
    "minimatch": "^10.2.5",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
