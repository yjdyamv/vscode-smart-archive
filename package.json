            "%config.backend.brotli.bundled%",
            "%config.backend.brotli.wasm%"
          ],
          "description": "%config.backend.brotli.description%"
        },
        "smart-archiver.backend.lz4": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "bundled",
            "wasm"
          ],
          "enumDescriptions": [
            "%config.backend.lz4.auto%",
            "%config.backend.lz4.bundled%",
            "%config.backend.lz4.wasm%"
          ],
          "description": "%config.backend.lz4.description%"
        },
        "smart-archiver.backend.rar": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "native",
            "wasm"
          ],
          "enumDescriptions": [
            "%config.backend.rar.auto%",
            "%config.backend.rar.native%",
            "%config.backend.rar.wasm%"
          ],
          "description": "%config.backend.rar.description%"
        },
        "smart-archiver.backend.snappy": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "native",
            "wasm"
          ],
          "enumDescriptions": [
            "%config.backend.snappy.auto%",
            "%config.backend.snappy.native%",
            "%config.backend.snappy.wasm%"
          ],
          "description": "%config.backend.snappy.description%"
        },
        "smart-archiver.backend.wasmTar": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "node-tar",
            "wasm"
          ],
          "enumDescriptions": [
            "%config.backend.wasmTar.auto%",
            "%config.backend.wasmTar.node-tar%",
            "%config.backend.wasmTar.wasm%"
          ],
          "description": "%config.backend.wasmTar.description%"
