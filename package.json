{
  "name": "smart-archive",
  "displayName": "Smart Archive",
  "description": "Compress and decompress files using JS7z + libarchive.js. Supports 7z, ZIP, RAR, TAR, GZip, BZip2, XZ with AES-256 encryption.",
  "version": "1.11.3",
  "publisher": "yjdyamv",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yjdyamv/vscode-smart-archive"
  },
  "icon": "icon_128x128.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "archive",
    "compress",
    "decompress",
    "7z",
    "zip",
    "rar",
    "tar",
    "gz",
    "bzip2",
    "xz",
    "zstd",
    "encrypt",
    "AES-256",
    "multi-volume"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "archiveViewer",
        "displayName": "Archive Viewer",
        "selector": [
          {
            "filenamePattern": "*.7z"
          },
          {
            "filenamePattern": "*.7z.*"
          },
          {
            "filenamePattern": "*.zip"
          },
          {
            "filenamePattern": "*.zip.*"
          },
          {
            "filenamePattern": "*.rar"
          },
          {
            "filenamePattern": "*.r[0-9][0-9]"
          },
          {
            "filenamePattern": "*.tar"
          },
          {
            "filenamePattern": "*.gz"
          },
          {
            "filenamePattern": "*.bz2"
          },
          {
            "filenamePattern": "*.xz"
          },
          {
            "filenamePattern": "*.tar.gz"
          },
          {
            "filenamePattern": "*.tar.bz2"
          },
          {
            "filenamePattern": "*.tar.xz"
          },
          {
            "filenamePattern": "*.tar.zst"
          },
          {
            "filenamePattern": "*.tar.lz"
          },
          {
            "filenamePattern": "*.tar.lzma"
          },
          {
            "filenamePattern": "*.tgz"
          },
          {
            "filenamePattern": "*.tbz2"
          },
          {
            "filenamePattern": "*.tbz"
          },
          {
            "filenamePattern": "*.txz"
          },
          {
            "filenamePattern": "*.tzst"
          },
          {
            "filenamePattern": "*.tlz"
          },
          {
            "filenamePattern": "*.wim"
          },
          {
            "filenamePattern": "*.zst"
          },
          {
            "filenamePattern": "*.cab"
          },
          {
            "filenamePattern": "*.arj"
          },
          {
            "filenamePattern": "*.lzh"
          },
          {
            "filenamePattern": "*.chm"
          },
          {
            "filenamePattern": "*.msi"
          },
          {
            "filenamePattern": "*.z"
          },
          {
            "filenamePattern": "*.cpio"
          },
          {
            "filenamePattern": "*.rpm"
          },
          {
            "filenamePattern": "*.deb"
          },
          {
            "filenamePattern": "*.uha"
          },
          {
            "filenamePattern": "*.xar"
          },
          {
            "filenamePattern": "*.iso"
          },
          {
            "filenamePattern": "*.vhd"
          },
          {
            "filenamePattern": "*.vmdk"
          },
          {
            "filenamePattern": "*.fat"
          },
          {
            "filenamePattern": "*.ntfs"
          },
          {
            "filenamePattern": "*.squashfs"
          },
          {
            "filenamePattern": "*.dmg"
          },
          {
            "filenamePattern": "*.hfs"
          },
          {
            "filenamePattern": "*.apm"
          },
          {
            "filenamePattern": "*.mbr"
          },
          {
            "filenamePattern": "*.elf"
          },
          {
            "filenamePattern": "*.macho"
          },
          {
            "filenamePattern": "*.swf"
          },
          {
            "filenamePattern": "*.flv"
          },
          {
            "filenamePattern": "*.vsix"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "yjdyamv.smart-archive.compress",
        "title": "Smart Archive: Compress",
        "shortTitle": "Compress",
        "icon": "$(archive)"
      },
      {
        "command": "yjdyamv.smart-archive.decompress",
        "title": "Smart Archive: Decompress",
        "shortTitle": "Decompress",
        "icon": "$(extract-zip)"
      },
      {
        "command": "yjdyamv.smart-archive.browse",
        "title": "Smart Archive: Browse Contents",
        "shortTitle": "Browse Contents",
        "icon": "$(list-tree)"
      },
      {
        "command": "yjdyamv.smart-archive.paste",
        "title": "Smart Archive: Paste Copied Files",
        "shortTitle": "Paste Files",
        "icon": "$(paste)"
      },
      {
        "command": "yjdyamv.smart-archive.addToArchive",
        "title": "Smart Archive: Add to Archive",
        "shortTitle": "Add to Archive",
        "icon": "$(add)"
      }
    ],
    "keybindings": [],
    "menus": {
      "commandPalette": [
        {
          "command": "yjdyamv.smart-archive.paste",
          "when": "false"
        },
        {
          "command": "yjdyamv.smart-archive.addToArchive",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "yjdyamv.smart-archive.compress",
          "group": "7_modification"
        },
        {
          "command": "yjdyamv.smart-archive.decompress",
          "group": "7_modification",
          "when": "resourceFilename =~ /\\.(7z|7z\\.[0-9]+|zip|zip\\.[0-9]+|rar|r\\d{2}|tar|gz|bz2|xz|zst|wim|tgz|tbz2|tbz|txz|tzst|tlz|lz|lzma|tar\\.gz|tar\\.bz2|tar\\.xz|tar\\.zst|tar\\.lz|tar\\.lzma|cab|arj|lzh|chm|msi|z|cpio|rpm|deb|uha|xar|iso|vhd|vmdk|fat|ntfs|squashfs|dmg|hfs|apm|mbr|elf|macho|swf|flv|vsix)$/"
        },
        {
          "command": "yjdyamv.smart-archive.browse",
          "group": "7_modification",
          "when": "resourceFilename =~ /\\.(7z|7z\\.[0-9]+|zip|zip\\.[0-9]+|rar|r\\d{2}|tar|gz|bz2|xz|zst|wim|tgz|tbz2|tbz|txz|tzst|tlz|lz|lzma|tar\\.gz|tar\\.bz2|tar\\.xz|tar\\.zst|tar\\.lz|tar\\.lzma|cab|arj|lzh|chm|msi|z|cpio|rpm|deb|uha|xar|iso|vhd|vmdk|fat|ntfs|squashfs|dmg|hfs|apm|mbr|elf|macho|swf|flv|vsix)$/"
        }
      ]
    },
    "configuration": {
      "title": "Smart Archive",
      "properties": {
        "smart-archive.defaultFormat": {
          "type": "string",
          "default": "7z",
          "enum": [
            "7z",
            "zip",
            "tar",
            "tar.gz",
            "tar.bz2",
            "tar.xz",
            "tar.zst",
            "wim"
          ],
          "enumDescriptions": [
            "7-Zip — best compression ratio, AES-256 encryption",
            "ZIP — universal compatibility, AES-256 encryption",
            "TAR — archive only, no compression",
            "TAR + GZip — compressed archive with directory structure",
            "TAR + BZip2 — high compression with directory structure",
            "TAR + XZ — best compression with directory structure",
            "TAR + Zstandard — fast compression with directory structure",
            "WIM — Windows Imaging Format"
          ],
          "description": "Default archive format used when compressing files."
        },
        "smart-archive.defaultCompressionLevel": {
          "type": "integer",
          "default": 5,
          "minimum": 0,
          "maximum": 9,
          "enum": [
            0,
            1,
            3,
            5,
            7,
            9
          ],
          "enumDescriptions": [
            "0 – Store (no compression, fastest)",
            "1 – Fastest",
            "3 – Fast",
            "5 – Normal",
            "7 – Maximum",
            "9 – Ultra (slowest, best ratio)"
          ],
          "description": "Default compression level (0=store, 5=normal, 9=ultra)."
        },
        "smart-archive.defaultOutputDir": {
          "type": "string",
          "default": "source",
          "enum": [
            "source",
            "prompt"
          ],
          "enumDescriptions": [
            "Extract/compress next to the source file",
            "Always prompt for output directory"
          ],
          "description": "Where to place extracted/compressed files by default."
        },
        "smart-archive.maxFileSizeMiB": {
          "type": "integer",
          "default": 1024,
          "minimum": 1,
          "maximum": 102400,
          "description": "Maximum allowed size for a single decompressed file (MiB). Default: 1024 MiB (= 1 GiB)."
        },
        "smart-archive.maxTotalSizeMiB": {
          "type": "integer",
          "default": 10240,
          "minimum": 1,
          "maximum": 512000,
          "description": "Maximum total decompressed size across all files (MiB). Default: 10240 MiB (= 10 GiB)."
        },
        "smart-archive.collapsedDirPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".npm",
            ".yarn",
            ".venv",
            "venv",
            "__pycache__",
            ".pytest_cache",
            ".mypy_cache",
            ".tox",
            ".eggs",
            "site-packages",
            ".git",
            ".svn",
            ".hg",
            "dist",
            "build",
            "target",
            "out",
            "output",
            ".next",
            ".nuxt",
            ".output",
            ".svelte-kit",
            ".idea",
            ".vscode",
            ".vs",
            "coverage",
            ".nyc_output",
            ".cache",
            ".turbo",
            ".parcel-cache",
            "vendor",
            "bower_components",
            ".terraform"
          ],
          "description": "Directory name patterns to keep collapsed by default in the archive preview. Remove or adjust patterns to suit your preferences."
        },
        "smart-archive.compressExcludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".npm",
            ".yarn",
            ".venv",
            "venv",
            "__pycache__",
            ".pytest_cache",
            ".mypy_cache",
            ".tox",
            ".eggs",
            "site-packages",
            ".git",
            ".svn",
            ".hg",
            "dist",
            "build",
            "target",
            "out",
            "output",
            ".next",
            ".nuxt",
            ".output",
            ".svelte-kit",
            ".idea",
            ".vscode",
            ".vs",
            "coverage",
            ".nyc_output",
            ".cache",
            ".turbo",
            ".parcel-cache",
            "vendor",
            "bower_components",
            ".terraform"
          ],
          "description": "Glob patterns (gitignore syntax) for files/directories to exclude when compressing. Example: ['node_modules', '.venv', '*.log', '**/dist']"
        },
        "smart-archive.defaultVolumeSize": {
          "type": "string",
          "default": "",
          "description": "Default split volume size (number + k/m/g suffix, e.g. 100m, 1g). Leave empty to skip splitting by default."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"['out','media/vue','coverage'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\"",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "build:webview": "npm --prefix webview-ui run build",
    "dev:webview": "npm --prefix webview-ui run dev",
    "install:webview": "npm --prefix webview-ui install",
    "build": "npm run build:webview && npm run compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",

    "format": "oxfmt --write src/ test/ webview-ui/src/",
    "format:check": "oxfmt --check src/ test/ webview-ui/src/",
    "lint": "oxlint -D correctness -D suspicious -A no-underscore-dangle -A unicorn/require-post-message-target-origin -A unicorn/no-array-sort src/ test/ webview-ui/src/",
    "lint:fix": "oxlint -D correctness -D suspicious -A no-underscore-dangle -A unicorn/require-post-message-target-origin -A unicorn/no-array-sort --fix src/ test/ webview-ui/src/",
    "typecheck": "tsc -p . --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "release": "npm run install:webview && npm run build && npm run check && npm run package",
    "package": "vsce package",
    "package:ovsx": "npm run build && npx ovsx package",
    "publish": "npm run build && npx vsce publish",
    "publish:ovsx": "npm run build && npx ovsx publish",
    "vscode:prepublish": "npm run build"
  },
  "overrides": {
    "encoding-sniffer": "1.0.2"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@vscode/codicons": "^0.0.45",
    "iconv-lite": "^0.7.2",
    "js7z-tools": "^2.5.0",
    "minimatch": "^10.2.5",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "glob": "^10.0.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
