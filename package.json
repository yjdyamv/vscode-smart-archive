{
  "name": "smart-archiver",
  "displayName": "Smart Archiver",
  "version": "2.6.6",
  "private": true,
  "description": "Compress, extract, and browse archives in VS Code — bundled 7-Zip, AES-256, zero install.",
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "7z",
    "AES-256",
    "archive",
    "bzip2",
    "compress",
    "decompress",
    "encrypt",
    "gz",
    "multi-volume",
    "rar",
    "tar",
    "xz",
    "zip",
    "zstd"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/yjdyamv/vscode-smart-archive"
  },
  "publisher": "yjdyamv",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "postinstall": "node scripts/install-7zz-wasm.mjs && npm --prefix webview-ui install",
    "compile": "vite build --config vite.extension.config.mts",
    "compile:dev": "cross-env SOURCEMAP=true vite build --config vite.extension.config.mts",
    "watch": "vite build --config vite.extension.config.mts --watch",
    "build:webview": "npm --prefix webview-ui run build",
    "build:webview:dev": "cross-env SOURCEMAP=true npm --prefix webview-ui run build",
    "dev:webview": "npm --prefix webview-ui run dev",
    "build": "cross-env SOURCEMAP=false npm run build:webview && cross-env SOURCEMAP=false npm run compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt --write src/ test/ webview-ui/src/ scripts/",
    "format:check": "oxfmt --check src/ test/ webview-ui/src/ scripts/",
    "lint": "oxlint -D correctness -D suspicious -A no-underscore-dangle -A unicorn/require-post-message-target-origin -A unicorn/no-array-sort -A unicorn/consistent-function-scoping -A no-control-regex src/ test/ webview-ui/src/ scripts/",
    "lint:fix": "oxlint -D correctness -D suspicious -A no-underscore-dangle -A unicorn/require-post-message-target-origin -A unicorn/no-array-sort -A unicorn/consistent-function-scoping -A no-control-regex --fix src/ test/ webview-ui/src/ scripts/",
    "typecheck": "tsc -p . --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "release": "npm run check && npm run package:cross",
    "stage:natives": "node scripts/install-7zz-wasm.mjs && cross-env SA_RAR5_REQUIRE=1 node scripts/install-rar5-platforms.mjs && node scripts/install-snappy-platforms.mjs && node scripts/install-7z-platforms.mjs",
    "verify:downloads": "node scripts/verify-downloads.mjs",
    "prepackage:cross": "node scripts/clear-native-locks.mjs",
    "package:cross": "node scripts/npm-ci-safe.mjs && node scripts/npm-ci-safe.mjs --prefix webview-ui && node scripts/package-native.mjs",
    "prepackage:wasm": "node scripts/clear-native-locks.mjs",
    "package:wasm": "node scripts/package-wasm.mjs",
    "vscode:prepublish": "npm run stage:natives && npm run build"
  },
  "dependencies": {
    "@napi-rs/wasm-runtime": "^1.2.3",
    "@vscode/codicons": "^0.0.46-24",
    "iconv-lite": "^0.7.3",
    "minimatch": "^10.2.5",
    "pino": "^10.3.1",
    "snappy": "^7.4.2",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^3.9.2",
    "cross-env": "^10.1.0",
    "https-proxy-agent": "^9.1.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "encoding-sniffer": "1.0.2"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "archiveViewer",
        "displayName": "Archive Viewer",
        "selector": [
          {
            "filenamePattern": "*.7z"
          },
          {
            "filenamePattern": "*.7z.*"
          },
          {
            "filenamePattern": "*.zip"
          },
          {
            "filenamePattern": "*.zip.*"
          },
          {
            "filenamePattern": "*.rar"
          },
          {
            "filenamePattern": "*.r[0-9][0-9]"
          },
          {
            "filenamePattern": "*.tar"
          },
          {
            "filenamePattern": "*.gz"
          },
          {
            "filenamePattern": "*.bz2"
          },
          {
            "filenamePattern": "*.xz"
          },
          {
            "filenamePattern": "*.tar.gz"
          },
          {
            "filenamePattern": "*.tar.bz2"
          },
          {
            "filenamePattern": "*.tar.xz"
          },
          {
            "filenamePattern": "*.tar.zst"
          },
          {
            "filenamePattern": "*.tar.lz"
          },
          {
            "filenamePattern": "*.tar.lzma"
          },
          {
            "filenamePattern": "*.tar.lz4"
          },
          {
            "filenamePattern": "*.tgz"
          },
          {
            "filenamePattern": "*.tbz2"
          },
          {
            "filenamePattern": "*.tbz"
          },
          {
            "filenamePattern": "*.txz"
          },
          {
            "filenamePattern": "*.tzst"
          },
          {
            "filenamePattern": "*.tlz"
          },
          {
            "filenamePattern": "*.tlz4"
          },
          {
            "filenamePattern": "*.tar.br"
          },
          {
            "filenamePattern": "*.tbr"
          },
          {
            "filenamePattern": "*.tar.sz"
          },
          {
            "filenamePattern": "*.tsz"
          },
          {
            "filenamePattern": "*.wim"
          },
          {
            "filenamePattern": "*.zst"
          },
          {
            "filenamePattern": "*.cab"
          },
          {
            "filenamePattern": "*.arj"
          },
          {
            "filenamePattern": "*.lzh"
          },
          {
            "filenamePattern": "*.chm"
          },
          {
            "filenamePattern": "*.msi"
          },
          {
            "filenamePattern": "*.z"
          },
          {
            "filenamePattern": "*.cpio"
          },
          {
            "filenamePattern": "*.rpm"
          },
          {
            "filenamePattern": "*.deb"
          },
          {
            "filenamePattern": "*.uha"
          },
          {
            "filenamePattern": "*.xar"
          },
          {
            "filenamePattern": "*.iso"
          },
          {
            "filenamePattern": "*.vhd"
          },
          {
            "filenamePattern": "*.vmdk"
          },
          {
            "filenamePattern": "*.fat"
          },
          {
            "filenamePattern": "*.ntfs"
          },
          {
            "filenamePattern": "*.squashfs"
          },
          {
            "filenamePattern": "*.dmg"
          },
          {
            "filenamePattern": "*.hfs"
          },
          {
            "filenamePattern": "*.apm"
          },
          {
            "filenamePattern": "*.mbr"
          },
          {
            "filenamePattern": "*.vsix"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "yjdyamv.smart-archiver.compress",
        "title": "Smart Archiver: Compress",
        "shortTitle": "Compress",
        "icon": "$(archive)"
      },
      {
        "command": "yjdyamv.smart-archiver.decompress",
        "title": "Smart Archiver: Extract",
        "shortTitle": "Extract",
        "icon": "$(folder-opened)"
      },
      {
        "command": "yjdyamv.smart-archiver.extractTo",
        "title": "Smart Archiver: Extract to…",
        "shortTitle": "Extract to…",
        "icon": "$(folder-opened)"
      },
      {
        "command": "yjdyamv.smart-archiver.browse",
        "title": "Smart Archiver: Browse Contents",
        "shortTitle": "Browse Contents",
        "icon": "$(list-tree)"
      },
      {
        "command": "yjdyamv.smart-archiver.paste",
        "title": "Smart Archiver: Paste Copied Files",
        "shortTitle": "Paste Files"
      },
      {
        "command": "yjdyamv.smart-archiver.addToArchive",
        "title": "Smart Archiver: Add to Archive",
        "shortTitle": "Add to Archive"
      },
      {
        "command": "yjdyamv.smart-archiver.repair",
        "title": "Smart Archiver: Repair Archive",
        "shortTitle": "Repair Archive",
        "icon": "$(wrench)"
      },
      {
        "command": "yjdyamv.smart-archiver.rebuildVolumes",
        "title": "Smart Archiver: Rebuild Missing Volumes",
        "shortTitle": "Rebuild Volumes",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "yjdyamv.smart-archiver.compress",
          "when": "false"
        },
        {
          "command": "yjdyamv.smart-archiver.decompress",
          "when": "false"
        },
        {
          "command": "yjdyamv.smart-archiver.extractTo",
          "when": "false"
        },
        {
          "command": "yjdyamv.smart-archiver.browse",
          "when": "false"
        },
        {
          "command": "yjdyamv.smart-archiver.paste",
          "when": "false"
        },
        {
          "command": "yjdyamv.smart-archiver.addToArchive",
          "when": "false"
        },
        {
          "command": "yjdyamv.smart-archiver.repair",
          "when": "false"
        },
        {
          "command": "yjdyamv.smart-archiver.rebuildVolumes",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "yjdyamv.smart-archiver.compress",
          "group": "6_smartarchiver"
        },
        {
          "command": "yjdyamv.smart-archiver.decompress",
          "group": "6_smartarchiver",
          "when": "resourceFilename =~ /\\.(7z|7z\\.[0-9]+|zip|zip\\.[0-9]+|rar|r\\d{2}|tar|gz|bz2|xz|zst|wim|tgz|tbz2|tbz|txz|tzst|tlz|tlz4|tbr|lz|lzma|tar\\.gz|tar\\.bz2|tar\\.xz|tar\\.zst|tar\\.lz|tar\\.lzma|tar\\.lz4|tar\\.br|tar\\.sz|tsz|cab|arj|lzh|chm|msi|z|cpio|rpm|deb|uha|xar|iso|vhd|vmdk|fat|ntfs|squashfs|dmg|hfs|apm|mbr|vsix|elf|macho|swf|flv)$/"
        },
        {
          "command": "yjdyamv.smart-archiver.extractTo",
          "group": "6_smartarchiver",
          "when": "config.smart-archiver.extractTo.enabled && resourceFilename =~ /\\.(7z|7z\\.[0-9]+|zip|zip\\.[0-9]+|rar|r\\d{2}|tar|gz|bz2|xz|zst|wim|tgz|tbz2|tbz|txz|tzst|tlz|tlz4|tbr|lz|lzma|tar\\.gz|tar\\.bz2|tar\\.xz|tar\\.zst|tar\\.lz|tar\\.lzma|tar\\.lz4|tar\\.br|tar\\.sz|tsz|cab|arj|lzh|chm|msi|z|cpio|rpm|deb|uha|xar|iso|vhd|vmdk|fat|ntfs|squashfs|dmg|hfs|apm|mbr|vsix|elf|macho|swf|flv)$/"
        },
        {
          "command": "yjdyamv.smart-archiver.browse",
          "group": "6_smartarchiver",
          "when": "resourceFilename =~ /\\.(7z|7z\\.[0-9]+|zip|zip\\.[0-9]+|rar|r\\d{2}|tar|gz|bz2|xz|zst|wim|tgz|tbz2|tbz|txz|tzst|tlz|tlz4|tbr|lz|lzma|tar\\.gz|tar\\.bz2|tar\\.xz|tar\\.zst|tar\\.lz|tar\\.lzma|tar\\.lz4|tar\\.br|tar\\.sz|tsz|cab|arj|lzh|chm|msi|z|cpio|rpm|deb|uha|xar|iso|vhd|vmdk|fat|ntfs|squashfs|dmg|hfs|apm|mbr|vsix|elf|macho|swf|flv)$/"
        },
        {
          "command": "yjdyamv.smart-archiver.repair",
          "when": "resourceExtname == .rar",
          "group": "6_smartarchiver"
        },
        {
          "command": "yjdyamv.smart-archiver.rebuildVolumes",
          "when": "resourceFilename =~ /\\.part1\\.rar$/i",
          "group": "6_smartarchiver"
        }
      ]
    },
    "configuration": {
      "title": "Smart Archiver",
      "properties": {
        "smart-archiver.default.format": {
          "type": "string",
          "default": "7z",
          "enum": [
            "7z",
            "zip",
            "tar",
            "tar.gz",
            "tar.bz2",
            "tar.xz",
            "tar.zst",
            "tar.lz4",
            "tar.br",
            "tar.sz",
            "wim"
          ],
          "enumDescriptions": [
            "%config.default.format.7z%",
            "%config.default.format.zip%",
            "%config.default.format.tar%",
            "%config.default.format.tar.gz%",
            "%config.default.format.tar.bz2%",
            "%config.default.format.tar.xz%",
            "%config.default.format.tar.zst%",
            "%config.default.format.tar.lz4%",
            "%config.default.format.tar.br%",
            "%config.default.format.tar.sz%",
            "%config.default.format.wim%"
          ],
          "description": "%config.default.format.description%"
        },
        "smart-archiver.default.formatOrder": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "7z",
              "zip",
              "rar",
              "tar.zst",
              "tar.gz",
              "tar.xz",
              "tar",
              "tar.bz2",
              "tar.lz4",
              "tar.br",
              "tar.sz",
              "wim"
            ]
          },
          "description": "%config.default.formatOrder.description%"
        },
        "smart-archiver.default.compressionLevel": {
          "type": "integer",
          "default": 5,
          "minimum": 0,
          "maximum": 9,
          "enum": [
            0,
            1,
            3,
            5,
            7,
            9
          ],
          "enumDescriptions": [
            "%config.default.compressionLevel.0%",
            "%config.default.compressionLevel.1%",
            "%config.default.compressionLevel.3%",
            "%config.default.compressionLevel.5%",
            "%config.default.compressionLevel.7%",
            "%config.default.compressionLevel.9%"
          ],
          "description": "%config.default.compressionLevel.description%"
        },
        "smart-archiver.limits.maxArchiveSize": {
          "type": [
            "integer",
            "string"
          ],
          "default": "1g",
          "pattern": "^(\\d+(\\.\\d+)?)\\s*(k|m|g)$",
          "description": "%config.limits.maxArchiveSize.description%"
        },
        "smart-archiver.limits.maxExtractTotalSize": {
          "type": [
            "integer",
            "string"
          ],
          "default": "10g",
          "pattern": "^(\\d+(\\.\\d+)?)\\s*(k|m|g)$",
          "description": "%config.limits.maxExtractTotalSize.description%"
        },
        "smart-archiver.extractTo.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.extractTo.enabled.description%"
        },
        "smart-archiver.patterns.collapsedDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".npm",
            ".yarn",
            ".venv",
            "venv",
            "__pycache__",
            ".pytest_cache",
            ".mypy_cache",
            ".tox",
            ".eggs",
            "site-packages",
            ".git",
            ".svn",
            ".hg",
            "dist",
            "build",
            "target",
            "out",
            "output",
            ".next",
            ".nuxt",
            ".output",
            ".svelte-kit",
            ".idea",
            ".vscode",
            ".vs",
            "coverage",
            ".nyc_output",
            ".cache",
            ".turbo",
            ".parcel-cache",
            "vendor",
            "bower_components",
            ".terraform"
          ],
          "description": "%config.patterns.collapsedDirs.description%"
        },
        "smart-archiver.patterns.compressExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".npm",
            ".yarn",
            ".venv",
            "venv",
            "__pycache__",
            ".pytest_cache",
            ".mypy_cache",
            ".tox",
            ".eggs",
            "site-packages",
            ".git",
            ".svn",
            ".hg",
            "dist",
            "build",
            "target",
            "out",
            "output",
            ".next",
            ".nuxt",
            ".output",
            ".svelte-kit",
            ".idea",
            ".vscode",
            ".vs",
            "coverage",
            ".nyc_output",
            ".cache",
            ".turbo",
            ".parcel-cache",
            "vendor",
            "bower_components",
            ".terraform"
          ],
          "description": "%config.patterns.compressExclude.description%"
        },
        "smart-archiver.volumes.sizes": {
          "type": "object",
          "default": {
            "1.44M": "1440k",
            "10M": "10m",
            "25M": "25m",
            "50M": "50m",
            "100M": "100m",
            "200M": "200m",
            "650M": "650m",
            "700M": "700m",
            "1G": "1g",
            "2G": "2g",
            "4.7G": "4700m"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^\\d+[kmg]$"
          },
          "markdownDescription": "%config.volumes.sizes.description%"
        },
        "smart-archiver.backend.7z": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "native",
            "bundled",
            "wasm"
          ],
          "enumDescriptions": [
            "%config.backend.7z.auto%",
            "%config.backend.7z.native%",
            "%config.backend.7z.bundled%",
            "%config.backend.7z.wasm%"
