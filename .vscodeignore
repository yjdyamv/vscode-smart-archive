# ── 项目源文件（不打包） ──
.github/**
src/**
test/**
scripts/**
webview-ui/**
test/__mocks__/**
.oxfmtrc.json
.oxlintrc.json
.vscode/**
tsconfig.json
vite.extension.config.ts
vite.extension.config.mts
vitest.config.ts
vitest.config.mts
TESTING-STANDARDS.md
ROADMAP.md
CONTEXT.md
.agents/**
.claude/**
skills-lock.json


# ── 排除整个 node_modules，只反选需要的文件 ──
node_modules/
# webview 只引用 codicon.css + 字体
!node_modules/@vscode/codicons/dist/codicon.css
!node_modules/@vscode/codicons/dist/codicon.ttf
!node_modules/@vscode/codicons/LICENSE
# snappy (zstd) native binding + WASI fallback — re-include the whole
# package so the CJS entry chain (main.js -> index.js + stream-polyfill.*)
# and all platform .node + WASI files ship. Enumerate-per-file here is
# fragile: snappy's main.js requires stream-polyfill.{js,mjs}, and any
# future addition silently breaks require("snappy") in the installed
# extension (seen in 2.6.3: "Cannot find module .../snappy/main.js").
!node_modules/snappy/**
# ia32 (32 位 x86 Windows) 已无 VS Code 支持（1.77 起停止发布）
node_modules/snappy/snappy.win32-ia32-msvc.node
# napi-rs wasm runtime: 只保留 CommonJS require 链（runtime.cjs →
# dist/emnapi-plugins.cjs + dist/fs-proxy.cjs → @emnapi/core/@emnapi/runtime）。
# ESM 变体（runtime.js / dist/fs.js / dist/emnapi-plugins.js / fs-proxy.js）
# 只被 "import" 条件触发，而 wasi-loader 全走 createRequire → CJS 链，是死重。
!node_modules/@napi-rs/wasm-runtime/runtime.cjs
!node_modules/@napi-rs/wasm-runtime/package.json
!node_modules/@napi-rs/wasm-runtime/dist/fs-proxy.cjs
!node_modules/@napi-rs/wasm-runtime/dist/emnapi-plugins.cjs
# @emnapi core/runtime: index.js 只 require 两个 CJS dist 变体
!node_modules/@emnapi/core/index.js
!node_modules/@emnapi/core/package.json
!node_modules/@emnapi/core/LICENSE
!node_modules/@emnapi/core/dist/emnapi-core.cjs.js
!node_modules/@emnapi/core/dist/emnapi-core.cjs.min.js
!node_modules/@emnapi/runtime/index.js
!node_modules/@emnapi/runtime/package.json
!node_modules/@emnapi/runtime/LICENSE
!node_modules/@emnapi/runtime/dist/emnapi.cjs.js
!node_modules/@emnapi/runtime/dist/emnapi.cjs.min.js
# emnapi 传递依赖：只保留 CommonJS require 链
# (@tybys/wasm-util main = lib/cjs/index.js，且其 CJS 链 require tslib)
!node_modules/@emnapi/wasi-threads/index.js
!node_modules/@emnapi/wasi-threads/package.json
!node_modules/@emnapi/wasi-threads/LICENSE
!node_modules/@emnapi/wasi-threads/dist/wasi-threads.cjs.js
!node_modules/@emnapi/wasi-threads/dist/wasi-threads.cjs.min.js
!node_modules/@tybys/wasm-util/package.json
!node_modules/@tybys/wasm-util/lib/cjs/**
!node_modules/tslib/tslib.js
!node_modules/tslib/package.json
!node_modules/tslib/LICENSE

# ── 输出 & 杂项 ──
.cache/**
test-results/**
coverage/**
**/*.map
**/.gitignore
**/.DS_Store
# 调试构建绝不进 release 包（loader 存在时优先加载它）
**/*.debug.wasm
